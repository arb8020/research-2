{
  "name": "blogs-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild settings.ts --bundle --format=iife --minify --outfile=build/settings.js && esbuild page.ts embeds/*/element.ts --bundle --format=esm --minify --loader:.py=text --outdir=build --outbase=.",
    "lint": "tsc --noEmit && oxlint -f default && cd .. && uv run ruff check",
    "test:nn-fit": "esbuild embeds/nn-fit/mlp.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=build/nn-fit.test.mjs && node build/nn-fit.test.mjs",
    "test:nn-fit-remote": "esbuild embeds/nn-fit/parity.ts --bundle --platform=node --format=esm --loader:.py=text --log-level=warning --outfile=build/nn-fit-parity.mjs && cd .. && uv run python web/embeds/nn-fit/remote_train_test.py web/build/nn-fit-parity.mjs",
    "test:nn-fit-grok": "cd .. && uv run python web/embeds/nn-fit/grok_train_test.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "codemirror": "6.0.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "esbuild": "0.28.2",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "6.0.3"
  }
}
