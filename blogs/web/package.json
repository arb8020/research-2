{
  "name": "blogs-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild settings.ts --bundle --format=iife --minify --outfile=build/settings.js && esbuild page.ts embeds/*/element.ts --bundle --format=esm --minify --outdir=build --outbase=.",
    "lint": "tsc --noEmit && eslint --max-warnings=0 . && cd .. && uv run ruff check",
    "test:nn-fit": "esbuild embeds/nn-fit/mlp.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=build/nn-fit.test.mjs && node build/nn-fit.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "codemirror": "6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
