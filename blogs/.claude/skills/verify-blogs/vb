DRIVES = {"build": drive_build, "plan": drive_plan, "cells": drive_cells, "embeds": drive_embeds, "links": drive_links,
          "connect": drive_connect, "nn-fit-remote": drive_nn_fit_remote}


def cmd_drive(args: argparse.Namespace) -> int:
    run = load_run()
    if run is None:
        print("no launched run: vb launch")
        return 1
    features = [f for name in args.features for f in (ALL if name == "all" else (name,))]
    bad = [f for f in features if f not in DRIVES]
    if bad:
        print(f"unknown feature(s) {bad}; features: {', '.join(FEATURES)}, all")
        return 1
    failed = []
    for feature in features:
        d = Drive(run, feature)
        d.say(f"== drive {feature} (run {run['id']}, {time.strftime('%H:%M:%S')})")
        if not doctor(d.log, quiet=True):
            d.say("doctor failed: not driving. Fix it (or `vb cleanup && vb launch`) first.")
            return 1
        try:
            DRIVES[feature](d)
        except Exception as e:  # noqa: BLE001
            d.expect(False, f"drive crashed: {type(e).__name__}: {e}")
        verdict = "PASS" if not d.failures else f"FAIL ({len(d.failures)}: {d.failures})"
        d.say(f"== {feature}: {verdict}; evidence {d.dir}")
        if d.failures:
            failed.append(feature)
    print(f"drive: {'all passed' if not failed else f'FAILED {failed}'}; evidence {run['evidence']}")
    return 1 if failed else 0


def cmd_cleanup(_: argparse.Namespace) -> int:
    run = load_run()
    evidence = Path(run["evidence"]) if run else None
    log = evidence / "cleanup.txt" if evidence else None
    if run is None:
        say(f"no run recorded in {RUN_FILE}: nothing of ours to stop")
    else:
        say(f"cleanup run {run['id']}", log)
        machines = Path(run["machines"])
        try:
            say(f"  ended sessions {local_relay.end(run['urls']['gateway'], local_relay.sessions(machines), FAKE_TOKEN)}", log)
        except OSError as e:
            say(f"  could not end the relay's sessions: {e}", log)
        for p in reversed(run["procs"]):
            if not group_alive(p["pgid"]):
                say(f"  {p['name']}: already gone", log)
            elif not ours(p):
                say(f"  {p['name']}: pid {p['pid']} now runs {command_of(p['pid'])!r}, not ours: left alone", log)
            else:
                kill_group(p["pgid"], log, p["name"])
        for name, port in run["ports"].items():
            owners = listening_pids(port)
            say(f"  port {port} ({name}): {'free' if not owners else f'STILL LISTENING {owners}'}", log)
        if run.get("reader_state_ours") and READER_STATE.exists():
            shutil.rmtree(READER_STATE)
            say(f"  removed this run's reader state {READER_STATE.relative_to(BLOGS)}", log)
        shutil.rmtree(machines, ignore_errors=True)
        RUN_FILE.unlink()
        say(f"  removed {RUN_FILE.relative_to(BLOGS)}", log)
    if SCAFFOLD.exists():
        shutil.rmtree(SCAFFOLD)
        say(f"  removed scaffolding {SCAFFOLD.name}/", log)
    for name in FIXTURES:
        if (stale := BLOGS / "dist" / Path(name).stem).exists():
            shutil.rmtree(stale)
            say(f"  removed dist/{stale.name}", log)
    if evidence is not None:
        kept = sorted(p.name for p in evidence.iterdir())
        say(f"evidence kept: {evidence} ({', '.join(kept)})", log)
        if not evidence.exists():
            print("FAIL: the evidence dir is gone")
            return 1
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("setup").set_defaults(fn=cmd_setup)
    p = sub.add_parser("launch")
    p.add_argument("--fresh", action="store_true", help=f"delete an existing {READER_STATE.relative_to(BLOGS)} first")
    p.set_defaults(fn=cmd_launch)
    sub.add_parser("doctor").set_defaults(fn=cmd_doctor)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    p = sub.add_parser("drive")
    p.add_argument("features", nargs="+", help=f"{', '.join(FEATURES)}, or all")
    p.set_defaults(fn=cmd_drive)
    sub.add_parser("cleanup").set_defaults(fn=cmd_cleanup)
    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
