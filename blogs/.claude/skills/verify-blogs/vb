def drive_connect(d: Drive) -> None:
    since = time.time()
    rc, out = d.sh(["uv", "run", "--with", "playwright", "verify_connect.py", "--gateway", d.run["urls"]["gateway"],
                    "--page-port", str(free_port())], env={"MODAL_TOKEN_ID": FAKE_TOKEN[0], "MODAL_TOKEN_SECRET": FAKE_TOKEN[1]})
    d.collect(BLOGS / ".evidence" / "verify_connect", since)
    d.expect(rc == 0, "verify_connect.py passes against our local relay")
    d.expect("bad token: " in out, "a token the gateway rejects shows the failure in the panel")
    d.expect("lease ran out" in out, "a session whose lease runs out says so")
    d.expect("stop: 'KeyboardInterrupt (" in out, "Stop interrupts a running scratch cell")
    d.expect("same kernel" in out, "reload reattaches to the same session + kernel")
    restore_neural_nets(d)


def drive_nn_fit_remote(d: Drive) -> None:
