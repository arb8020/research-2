SKILL = Path(__file__).resolve().parent
BLOGS = SKILL.parents[2]
sys.path.insert(0, str(BLOGS))
import local_relay  # noqa: E402

RUN_FILE = BLOGS / ".session" / "verify-blogs" / "run.json"
EVIDENCE_ROOT = BLOGS / ".evidence" / "verify-blogs"
SCAFFOLD = BLOGS / "verify-blogs-scaffold"
READER_STATE = BLOGS / ".session" / "01-flappy"
USER_PORTS = {8010, 8012, 8060, 8787, 8790}
CHROME_GLOB = "~/Library/Caches/ms-playwright/chromium-*/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
FAKE_TOKEN = ("ak-verify-blogs", "as-verify-blogs-secret")
JUPYTER_FIRST_START_S = 240
FEATURES = ("build", "plan", "cells", "embeds", "links", "connect", "nn-fit-remote")
ALL = ("build", "plan", "embeds", "links", "cells", "connect")


def say(msg: str, log: Path | None = None) -> None:
    print(msg, flush=True)
    if log is not None:
        with log.open("a") as f:
            f.write(msg + "\n")


def free_port() -> int:
    while True:
        with socket.socket() as s:
            s.bind(("127.0.0.1", 0))
            port = int(s.getsockname()[1])
        if port not in USER_PORTS:
            return port


def http_get(url: str, timeout: float = 5) -> tuple[int, str]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.status, r.read().decode(errors="replace")
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode(errors="replace")


def load_run() -> dict | None:
    return json.loads(RUN_FILE.read_text()) if RUN_FILE.exists() else None


def save_run(run: dict) -> None:
    RUN_FILE.parent.mkdir(parents=True, exist_ok=True)
    RUN_FILE.write_text(json.dumps(run, indent=1))
    (Path(run["evidence"]) / "run.json").write_text(json.dumps(run, indent=1))


def command_of(pid: int) -> str:
    out = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True)
    return out.stdout.strip()


def group_alive(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def ours(proc: dict) -> bool:
    return proc["match"] in command_of(proc["pid"])


def listening_pids(port: int) -> list[int]:
    out = subprocess.run(["lsof", "-nP", "-t", f"-iTCP:{port}", "-sTCP:LISTEN"], capture_output=True, text=True)
    return [int(p) for p in out.stdout.split()]


def pgid_of(pid: int) -> int | None:
    try:
        return os.getpgid(pid)
    except ProcessLookupError:
        return None


def kill_group(pgid: int, log: Path | None = None, label: str = "") -> None:
    if not group_alive(pgid):
        return
    os.killpg(pgid, signal.SIGTERM)
    for _ in range(50):
        if not group_alive(pgid):
            say(f"  stopped {label} (pgid {pgid})", log)
            return
        time.sleep(0.2)
    os.killpg(pgid, signal.SIGKILL)
    say(f"  killed {label} (pgid {pgid}) after TERM timed out", log)


def chrome() -> str | None:
    found = sorted(glob.glob(os.path.expanduser(CHROME_GLOB)))
    return found[-1] if found else None


def cmd_setup(_: argparse.Namespace) -> int:
    web = BLOGS / "web"
    if not (web / "node_modules" / ".bin" / "esbuild").exists():
        print("npm ci in blogs/web (fresh worktree)")
        subprocess.run(["npm", "ci", "--no-audit", "--no-fund"], cwd=web, check=True)
    else:
        print("web/node_modules present")
    if chrome() is None:
        print("no Playwright Chromium: installing")
        subprocess.run(["uv", "run", "--with", "playwright", "playwright", "install", "chromium"], cwd=BLOGS, check=True)
    print("ok: now `vb launch`")
    return 0


def spawn(name: str, argv: list[str], log: Path, match: str, env: dict | None = None) -> dict:
    out = log.open("ab")
    proc = subprocess.Popen(argv, cwd=BLOGS, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                            start_new_session=True, env=env)
    return {"name": name, "pid": proc.pid, "pgid": proc.pid, "argv": argv, "match": match, "log": str(log)}


def wait_http(url: str, ok: tuple[int, ...], seconds: float, proc: dict) -> bool:
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        if not group_alive(proc["pgid"]):
            return False
        try:
            code, _ = http_get(url, timeout=2)
            if code in ok:
                return True
        except OSError:
            pass
        time.sleep(0.3)
    return False


def build_cmd(run: dict, *chapters: str) -> list[str]:
    return ["uv", "run", "build_page.py", *(chapters or ("--all",)),
            "--session-url", run["urls"]["session"], "--gateway-url", run["urls"]["gateway"]]


def cmd_launch(args: argparse.Namespace) -> int:
    if (run := load_run()) is not None:
        live = [p["name"] for p in run["procs"] if group_alive(p["pgid"]) and ours(p)]
        print(f"a run is recorded in {RUN_FILE} ({run['id']}; live: {live or 'none'}). `vb cleanup` first.")
        return 1
    if not (BLOGS / "web" / "node_modules" / ".bin" / "esbuild").exists():
        print("FAIL web/node_modules missing (the builder only says `esbuild: command not found`): run `vb setup`")
        return 1
    if READER_STATE.exists():
        if not args.fresh:
            print(f"FAIL {READER_STATE} exists (someone's reader progress in this worktree; verify_page.py needs a fresh"
                  " reader). Re-run with --fresh to delete it, or move it aside.")
            return 1
        shutil.rmtree(READER_STATE)

    run_id = time.strftime("%Y%m%d-%H%M%S")
    evidence = EVIDENCE_ROOT / run_id
    (evidence / "logs").mkdir(parents=True)
    ports = {"session": free_port(), "static": free_port(), "gateway": free_port()}
    run = {
        "id": run_id, "evidence": str(evidence), "ports": ports, "procs": [], "reader_state_ours": True,
        "machines": str(RUN_FILE.parent / f"machines-{run_id}"),
        "branch": subprocess.run(["git", "branch", "--show-current"], cwd=BLOGS, capture_output=True, text=True).stdout.strip(),
        "head": subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=BLOGS, capture_output=True, text=True).stdout.strip(),
        "urls": {
            "session": f"http://127.0.0.1:{ports['session']}",
            "static": f"http://127.0.0.1:{ports['static']}",
            "gateway": f"http://127.0.0.1:{ports['gateway']}",
        },
    }
    save_run(run)
    log = evidence / "launch.txt"
    say(f"run {run_id} on {run['branch']} @ {run['head']}; ports {ports}", log)

    say("$ " + " ".join(build_cmd(run)), log)
    with (evidence / "logs" / "build.log").open("w") as out:
        rc = subprocess.run(build_cmd(run), cwd=BLOGS, stdout=out, stderr=subprocess.STDOUT).returncode
    say(f"  build exit {rc} (logs/build.log)", log)
    if rc != 0:
        say("FAIL build: see logs/build.log; then `vb cleanup`", log)
        return 1

    specs = [
        ("session", ["uv", "run", "session.py", "rl/01-flappy.md", "--port", str(ports["session"]), "--timeout", "20"],
         f"--port {ports['session']}", f"{run['urls']['session']}/state", (200,), 180),
        ("static", [sys.executable, "-m", "http.server", str(ports["static"]), "-d", "dist", "--bind", "127.0.0.1"],
         f"http.server {ports['static']}", f"{run['urls']['static']}/01-flappy/", (200,), 30),
        ("gateway", local_relay.local(ports["gateway"], Path(run["machines"]), "--lease-min-s", "2"),
         f"--port {ports['gateway']}", f"{run['urls']['gateway']}/limits", (200,), JUPYTER_FIRST_START_S),
    ]
    for name, argv, match, probe, ok, seconds in specs:
        proc = spawn(name, argv, evidence / "logs" / f"{name}.log", match)
        run["procs"].append(proc)
        save_run(run)
        say(f"$ {' '.join(argv)}   (pgid {proc['pgid']})", log)
        if not wait_http(probe, ok, seconds, proc):
            say(f"FAIL {name} not ready at {probe} within {seconds}s: see logs/{name}.log; then `vb cleanup`", log)
            return 1
        say(f"  {name} ready: {probe}", log)

    say("ready. drive these URLs (always pass ?gateway= on Connect pages):", log)
    print_urls(run, log)
    return 0


def print_urls(run: dict, log: Path | None = None) -> None:
    s, g = run["urls"]["static"], run["urls"]["gateway"]
    say(f"  flappy (checked cells): {s}/01-flappy/", log)
    say(f"  neural-nets (Connect):  {s}/neural-nets/?gateway={g}", log)
    say(f"  engine plan:            {s}/00-plan/", log)
    say(f"  session.py:             {run['urls']['session']}/state", log)
    say(f"  evidence:               {run['evidence']}", log)


def cmd_status(_: argparse.Namespace) -> int:
    run = load_run()
    if run is None:
        print("no run recorded (vb launch)")
        return 1
    print(f"run {run['id']} on {run['branch']} @ {run['head']}")
    for p in run["procs"]:
        print(f"  {p['name']:8} pgid {p['pgid']:6} {'alive' if group_alive(p['pgid']) and ours(p) else 'DEAD'}  {' '.join(p['argv'])}")
    print_urls(run)
    return 0


def doctor(log: Path | None = None, quiet: bool = False) -> bool:
    fails: list[str] = []

    def check(ok: bool, what: str, fix: str = "", warn: bool = False) -> None:
        tag = "PASS" if ok else ("WARN" if warn else "FAIL")
        line = f"{tag} {what}" + ("" if ok or not fix else f"  -> {fix}")
        if quiet and ok and log is not None:
            with log.open("a") as f:
                f.write(line + "\n")
        else:
            say(line, log)
        if not ok and not warn:
            fails.append(what)

    branch = subprocess.run(["git", "branch", "--show-current"], cwd=BLOGS, capture_output=True, text=True).stdout.strip()
    head = subprocess.run(["git", "log", "-1", "--format=%h %s"], cwd=BLOGS, capture_output=True, text=True).stdout.strip()
    say(f"INFO checkout {BLOGS} branch {branch or '(detached)'} @ {head}", log)
    check((BLOGS / "web" / "node_modules" / ".bin" / "esbuild").exists(), "web/node_modules (esbuild) present",
          "vb setup (npm ci in web/); without it build_page.py fails with only `esbuild: command not found`")
    check(shutil.which("uv") is not None, "uv on PATH")
    check((BLOGS / ".venv" / "bin" / "python").exists(), "blogs/.venv present", "first `uv run` creates it", warn=True)
    check(chrome() is not None, "Playwright Chromium in ~/Library/Caches/ms-playwright", "vb setup")
    check(shutil.which("emcc") is not None, "emcc on PATH (play widget wasm)", "brew install emscripten")
    check(shutil.which("clang") is not None, "clang on PATH (C cells, ASan)")
    check(bool(glob.glob(str(BLOGS / "vendor" / "raylib-*"))), "vendor/raylib-* fetched", "the first build downloads it", warn=True)
    check(not SCAFFOLD.exists(), f"no leftover scaffolding at {SCAFFOLD.name}/", "vb cleanup", warn=True)

    run = load_run()
    check(run is not None, f"a launched run is recorded ({RUN_FILE.relative_to(BLOGS)})", "vb launch")
    if run is None:
        say(f"doctor: {len(fails)} FAIL", log)
        return False
    say(f"INFO run {run['id']} launched on {run['branch']} @ {run['head']}", log)
    check(run["branch"] == branch, f"run launched on the current branch ({run['branch']})", "vb cleanup && vb launch")
    for p in run["procs"]:
        alive = group_alive(p["pgid"]) and ours(p)
        check(alive, f"{p['name']} alive (pid {p['pid']}, {p['match']!r})", "vb cleanup && vb launch")
        port = run["ports"][p["name"]]
        owners = listening_pids(port)
        check(bool(owners) and all(pgid_of(o) == p["pgid"] for o in owners),
              f"{p['name']} port {port} listened on only by our process group {p['pgid']} (owners {owners})")
    check(not (set(run["ports"].values()) & USER_PORTS), f"run ports {sorted(run['ports'].values())} avoid the author's {sorted(USER_PORTS)}")

    s = run["urls"]
    try:
        code, body = http_get(f"{s['session']}/state")
        state = json.loads(body) if code == 200 else {}
        check(code == 200 and {"passed", "wasm"} <= set(state), f"session /state answers (passed: {sorted(state.get('passed', {}))})")
    except (OSError, ValueError) as e:
        check(False, f"session /state answers ({e})")
    try:
        code, page = http_get(f"{s['static']}/01-flappy/")
        meta = re.search(r'<meta name="session-url" content="([^"]+)">', page)
        check(code == 200 and meta is not None and meta[1] == s["session"],
              f"served 01-flappy points at our session ({meta[1] if meta else None})", "rebuild: vb drive build")
        code, nn = http_get(f"{s['static']}/neural-nets/")
        gw = re.search(r'<connect-pill data-gateway="([^"]+)"', nn)
        check(code == 200 and gw is not None and gw[1] == s["gateway"],
              f"served neural-nets' data-gateway is ours ({gw[1] if gw else None})",
              "a harness rebuilt it with the default (the author's relay :8790): vb drive build", warn=True)
    except OSError as e:
        check(False, f"static server answers ({e})")
    try:
        code, body = http_get(f"{s['gateway']}/limits")
        check(code == 200 and "lease" in json.loads(body), f"the relay answers (GET /limits -> {body})")
    except (OSError, ValueError) as e:
        check(False, f"the relay answers ({e})")
    built = BLOGS / "dist" / "01-flappy" / "page.js"
    sources = [BLOGS / "web" / "page.ts", *BLOGS.glob("web/connect/*.ts"), *BLOGS.glob("*/*.md")]
    newest = max(p.stat().st_mtime for p in sources if p.exists() and not {".claude", "notes"} & set(p.relative_to(BLOGS).parts))
    check(built.exists() and built.stat().st_mtime >= newest, "dist/ is newer than web/*.ts and the chapters",
          "sources changed since the build: vb drive build", warn=True)
    say(f"doctor: {'ok' if not fails else f'{len(fails)} FAIL'}", log)
    return not fails


def cmd_doctor(_: argparse.Namespace) -> int:
    return 0 if doctor() else 1


class Drive:
    def __init__(self, run: dict, feature: str) -> None:
        self.run = run
        self.feature = feature
        self.dir = Path(run["evidence"]) / feature
        self.dir.mkdir(parents=True, exist_ok=True)
        self.log = self.dir / "transcript.txt"
        self.failures: list[str] = []

    def say(self, msg: str) -> None:
        say(msg, self.log)

    def expect(self, ok: bool, what: str) -> None:
        self.say(f"{'ok  ' if ok else 'FAIL'} {what}")
        if not ok:
            self.failures.append(what)

    def sh(self, argv: list[str], env: dict | None = None) -> tuple[int, str]:
        self.say("$ " + " ".join(argv))
        proc = subprocess.Popen(argv, cwd=BLOGS, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                start_new_session=True, env={**{k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV"}, **(env or {})})
        out = []
        assert proc.stdout is not None
        for line in proc.stdout:
            out.append(line)
            self.say("  | " + line.rstrip("\n"))
        rc = proc.wait()
        kill_group(proc.pid, self.log, f"stragglers of {Path(argv[-1]).name}")
        self.say(f"  exit {rc}")
        return rc, "".join(out)

    def pages(self, case: str, *extra: str) -> int:
        rc, _ = self.sh(["uv", "run", "--with", "playwright", "python", str(SKILL / "pages.py"), case,
                         "--base", self.run["urls"]["static"],
                         "--out", str(self.dir), *extra])
        return rc

    def collect(self, src: Path, since: float) -> None:
        n = 0
        for f in sorted(src.rglob("*")) if src.exists() else []:
            if f.is_file() and f.stat().st_mtime >= since:
                dest = self.dir / f.relative_to(src)
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(f, dest)
                n += 1
        self.say(f"  collected {n} artifact(s) from {src.relative_to(BLOGS)}/")


def read(path: Path) -> str:
    return path.read_text() if path.exists() else ""


FIXTURES = {
    "vf-page-ok.md": (True, "wrote"),
    "vf-excerpt-bad.md": (False, "is not in ../vendor/pufferlib/pufferenv.h verbatim"),
    "vf-leak.md": (False, "leaked into the page"),
    "vf-bad-link.md": (False, "no chapter called vf-no-such-page"),
    "vf-wip-empty.md": (False, "<!-- wip: --> needs text"),
    "vf-scratch-no-connect.md": (False, "scratch cells need <!-- page: connect -->"),
}


def drive_build(d: Drive) -> None:
    rc, out = d.sh(build_cmd(d.run, "rl/01-flappy.md"))
    d.expect(rc == 0 and "dist/01-flappy/index.html" in out and "cells ['flappy', 'policy'" in out, "single chapter builds")
    rc, out = d.sh(build_cmd(d.run))
    wrote = re.findall(r"wrote \S+/dist/([^/]+)/index.html", out)
    d.expect(rc == 0 and {"01-flappy", "neural-nets", "00-plan"} <= set(wrote), f"--all builds every chapter ({wrote})")

    dist = BLOGS / "dist"
    flappy, nn, plan = (read(dist / n / "index.html") for n in ("01-flappy", "neural-nets", "00-plan"))
    d.expect(not re.search(r"(solution|check|budget)=", flappy), "01-flappy: no solution=/check=/budget= fence in the page")
    d.expect("flappy-&gt;tick += 1" not in flappy and "flappy->tick += 1" not in flappy, "01-flappy: the reference puf_step line is not in the page")
    d.expect(flappy.count("<code-cell ") == 6 and '<env-play cell="flappy"' in flappy, "01-flappy: 6 <code-cell>s and <env-play cell=flappy>")
    d.expect('<div class="todo" role="note"' in flappy, "01-flappy: <!-- --> placeholders render as .todo notes")
    d.expect('<page-link data-embeds="nn-fit"><a href="../neural-nets/#fitting-a-curve">' in flappy, "01-flappy: [[neural-nets#fitting a curve]] -> <page-link>")
    d.expect('aria-label="under construction"' in nn and "still working on" in nn, "neural-nets: wip banner")
    d.expect(f'<connect-pill data-gateway="{d.run["urls"]["gateway"]}">' in nn and "<scratch-cell" in nn, "neural-nets: connect pill (our gateway) + scratch cell")
    d.expect('aria-label="under construction"' in plan and "plan only. no prose yet" in plan, "00-plan: wip banner")
    (d.dir / "built").mkdir(exist_ok=True)
    for name in ("01-flappy", "neural-nets", "00-plan"):
        shutil.copy2(dist / name / "index.html", d.dir / "built" / f"{name}.html")

    try:
        for name, (should_build, needle) in FIXTURES.items():
            shutil.rmtree(SCAFFOLD, ignore_errors=True)
            SCAFFOLD.mkdir()
            (SCAFFOLD / "SCAFFOLD.txt").write_text("verification scaffolding from .claude/skills/verify-blogs (vb drive build); vb cleanup removes it\n")
            shutil.copy(SKILL / "fixtures" / name, SCAFFOLD / name)
            rc, out = d.sh(["uv", "run", "build_page.py", f"{SCAFFOLD.name}/{name}"])
            d.expect((rc == 0) == should_build and needle in out,
                     f"fixture {name}: {'builds' if should_build else 'fails the build'} with {needle!r}")
            if should_build:
                d.expect(d.pages("fixture", "--path", f"/{Path(name).stem}/") == 0, "fixture page renders excerpt, wip, todo, link")
    finally:
        shutil.rmtree(SCAFFOLD, ignore_errors=True)
        for name in FIXTURES:
            shutil.rmtree(dist / Path(name).stem, ignore_errors=True)
    d.expect(not SCAFFOLD.exists(), "scaffolding removed")


def drive_plan(d: Drive) -> None:
    rc, out = d.sh(build_cmd(d.run, "engine/00-plan.md"))
    d.expect(rc == 0 and "dist/00-plan/index.html: cells [], scratch 0, connect False" in out, "engine/00-plan.md builds alone")
    d.expect(d.pages("plan") == 0, "plan page: title, wip banner, heading ids, no session traffic")


def drive_cells(d: Drive) -> None:
    if (READER_STATE / "state.json").exists():
        if not d.run.get("reader_state_ours"):
            d.expect(False, f"{READER_STATE} is not this run's; refusing to reset it")
            return
        shutil.rmtree(READER_STATE)
        d.say(f"  reset this run's reader state ({READER_STATE.relative_to(BLOGS)}) for a fresh reader")
    since = time.time()
    rc, out = d.sh(["uv", "run", "--with", "playwright", "verify_page.py", f"{d.run['urls']['static']}/01-flappy/"])
    d.collect(BLOGS / ".evidence" / "verify_page", since)
    d.expect(rc == 0, "verify_page.py passes")
    d.expect("run flappy" in out and "-> PASS" in out and "-> FAIL" in out, "flappy: stub FAILs, solution PASSes")
    d.expect("sample unlocked: True" in out, "gating: passing policy unlocks sample")
    d.expect("restored to last passing = True" in out, "reload restores the last passing flappy")
    code, body = http_get(f"{d.run['urls']['session']}/state")
    (d.dir / "state-after.json").write_text(body)
    state = json.loads(body) if code == 200 else {"passed": {}}
    d.expect({"flappy", "policy"} <= set(state["passed"]), f"side effect: session state.json has passed {sorted(state['passed'])}")


