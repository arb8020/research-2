{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "1.0",
  "description": "Highlight text, ask a coding agent, get answers in a side panel.",
  "permissions": ["sidePanel", "contextMenus", "activeTab", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {}
}
