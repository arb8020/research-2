  "scope": {
    "included": [
      "all sets accepted by the pinned gen3ou validator after normalization",
      "all battle effects reachable from those sets and pinned format rules",
      "battle execution from initial placement through win or tie"
    ],
    "excluded": [
      "team parsing and team validation inside the submitted runtime",
      "doubles, multi, free-for-all, custom, illegal, and non-Gen-3 formats",
      "team preview when not requested by pinned gen3ou",
      "chat, timer, concede, matchmaking, tournament, and administration",
      "presentation-only protocol text, nicknames, timestamps, and duplicate percentage HP lines",
      "policy learning and opponent AI"
    ]
  },
  "observables": [
    "choices", "actions", "queue", "handlers", "phase_request",
    "canonical_state", "events", "prng", "faint_switch_replace",
    "terminal", "replay", "ocean"
  ],
