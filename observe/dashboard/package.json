{
  "name": "observe-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "./scripts/test.sh",
    "preview": "vite preview",
    "serve": "bun server/server.ts --runs ../../runs",
    "test:server": "bun test server/"
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.0-r.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vega": "6.4.0",
    "vega-embed": "7.2.0",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
