{
  "static": {
    "token": {
      "A": "browser localStorage; sent on every call; the relay holds it for one request (or the boot thread), keeps a sha256 digest (relay.py digest/Boot.token_digest). Jupyter token = HMAC(secret, session) (relay.py kernel_token): derived, never stored.",
      "B": "as A on the relay, plus: OwnerDO stores the reader's Modal token {id, secret} in DO SQLite from create until the session ends (owner-do.ts created -> setEnded drops it), and Jupyter's token (upstream); the browser gets a DO-minted kernel token.",
      "C": "as A on the relay; the Worker passes it through (never stored); FanoutDO keeps only a sha256 digest. The ring holds the running status, so the derived Jupyter token sits in DO SQLite while the ring keeps that event."
    },
    "authority": {
      "A": "the machine (supervisor: lease, deadline, idle). The relay keeps boot records in memory <=10 min (rebuildable).",
      "B": "two: the DO (status, deadline alarm, token, kernel proxy) and the machine (idle, backstop deadline = DO's + 120 s).",
      "C": "the machine, as A. The DO is a cache (event ring + digest): lose it and only replay is lost."
    },
    "deploy": {
      "A": "one Python process the browser can reach (dev: localhost) + the reader's Modal.",
      "B": "A's relay reachable by the Worker (dev: cloudflared quick tunnel) + Worker + 1 SQLite DO class + PUSH_SECRET; machine egress to workers.dev.",
      "C": "same as B (different DO class)."
    }
  },
